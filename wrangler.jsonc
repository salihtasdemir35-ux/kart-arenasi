// Cloudflare Workers ayarı — GitHub'dan otomatik dağıtımda bu dosya kullanılır.
{
  "name": "kart-arenasi",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "apps/client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "KartHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KartHub"] }],
  "observability": { "enabled": true }
}
